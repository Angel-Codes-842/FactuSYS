# Copiar a .env.local para desarrollo; en Vercel cargar estas mismas claves
# en Project Settings > Environment Variables antes de disparar el build.
# VITE_* se sustituye en tiempo de build: cambiar una variable exige redeploy.

VITE_API_MODE=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<valor-de-Project-Settings-API-Keys>

# Compatibilidad con proyectos que aún no generaron las claves nuevas:
# VITE_SUPABASE_ANON_KEY=<anon-key-legacy>

# Solo aplica cuando VITE_API_MODE=legacy (Django):
# VITE_API_URL=http://localhost:8000/api
