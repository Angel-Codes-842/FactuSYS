# Modo mock por defecto mientras no haya cuenta test de FactPy.
FACTPY_MODE=mock

# Solo para emisiones reales (homologación primero).
FACTPY_RECORD_ID=
FACTPY_API_URL=https://api.factpy.com/facturacion-api
# La doc pública muestra .php en el encabezado y sin extensión en los cURL.
# Se dejan configurables para validar con soporte antes de producción.
# La doc V1 publica /data/ y /evento/; otras páginas muestran data.php / evento.php.
FACTPY_DOCS_PATH=data/
FACTPY_EVENTOS_PATH=evento/
FACTPY_ESTADO_PATH=estadoDE.php

SUPABASE_URL=http://127.0.0.1:54321
# Las Functions leen primero los JSON por nombre y caen a las legacy.
# SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_..."}
# SUPABASE_SECRET_KEYS={"default":"sb_secret_..."}
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
